---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="desc">That page has moved or never existed. Try the <a href="/">home page</a>, the <a href="/work/">case studies</a> or the <a href="/cv/">CV</a>.</p>
    </header>
  </div>
</Base>
