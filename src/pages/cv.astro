---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE, CONTACT, EXPERIENCE, EDUCATION, SKILLS } from '../data/site';
import { personSchema, profilePageSchema } from '../lib/schema';
---
<Base title="CV" type="profile"
  description="CV of Manish Tripathi, Product Manager at Aurora Energy Research: data product management, data licensing and governance, pipelines and analytics team leadership."
  schema={[personSchema(), profilePageSchema(`${SITE.url}/cv/`)]}>
  <div class="wrap">
    <header class="page-head cv-head">
      <h1>Manish Tripathi</h1>
      <p class="desc">{SITE.positioning}</p>
      <p class="small">
        {SITE.location} ·
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> ·
        {CONTACT.phones.map((p, i) => <>{i > 0 && ' · '}<a href={`tel:${p.tel}`}>{p.display}</a> ({p.label})</>)} ·
        <a href={CONTACT.linkedin}>linkedin.com/in/maneeshtripathi</a>
      </p>
      <p class="no-print"><button class="button ghost" type="button" onclick="window.print()">Print or save as PDF</button></p>
    </header>

    <section class="section" aria-labelledby="exp">
      <SectionHead num="01" kicker="Experience" title="Experience" id="exp" />
      {EXPERIENCE.map((r) => (
        <div class="role">
          <div class="role-head">
            <h3>{r.role}, <a href={r.url}>{r.company}</a></h3>
            <span class="period">{r.period}</span>
          </div>
          <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
        </div>
      ))}
    </section>

    <section class="section" aria-labelledby="edu">
      <SectionHead num="02" kicker="Education" title="Education" id="edu" />
      {EDUCATION.map((e) => (
        <div class="role">
          <div class="role-head">
            <h3>{e.detail}</h3>
            <span class="period">{e.year}</span>
          </div>
          <p style="margin:.4rem 0 0">{e.school}{e.honours && <> ({e.honours})</>}{e.note && <span class="muted">. {e.note}</span>}</p>
        </div>
      ))}
    </section>

    <section class="section" aria-labelledby="skills">
      <SectionHead num="03" kicker="Skills" title="Skills" id="skills" />
      <div class="skills">
        {SKILLS.map((s) => (
          <div>
            <h3>{s.group}</h3>
            <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>
