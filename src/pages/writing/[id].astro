---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import { articleSchema } from '../../lib/schema';
import { SHOW_DRAFTS } from '../../lib/drafts';

export async function getStaticPaths() {
  const posts = await getCollection('writing', (p) => SHOW_DRAFTS || !p.data.draft);
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const url = `${SITE.url}/writing/${entry.id}/`;
const date = entry.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={entry.data.title} description={entry.data.description} type="article" noindex={entry.data.draft}
  schema={entry.data.draft ? [] : [articleSchema({ url, title: entry.data.title, description: entry.data.description, date: entry.data.date })]}>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Writing · <time datetime={entry.data.date.toISOString().slice(0, 10)}>{date}</time></p>
      <h1>{entry.data.title}</h1>
      <p class="desc">{entry.data.description}</p>
    </header>
    {entry.data.draft && (
      <p class="draft-note"><strong>Draft for review.</strong> This piece is not published: it only appears on preview builds and is hidden from search engines.</p>
    )}
    <article class="prose">
      <Content />
    </article>
    <nav class="pager" aria-label="More">
      <a href="/writing/">← All writing</a>
      <a href="/work/">Case studies →</a>
    </nav>
  </div>
</Base>
